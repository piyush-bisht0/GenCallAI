# Gemini API Key (Required for Summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# Milvus Configuration (Optional)
# The system is configured to use a local SQLite-based Milvus Lite database by default.
# If you wish to use a cloud Milvus (Zilliz) instance, uncomment and fill in the following:
# MILVUS_PUBLIC_ENDPOINT=https://your-cloud-endpoint.zillizcloud.com
# MILVUS_API_KEY=your_zilliz_api_key_here
